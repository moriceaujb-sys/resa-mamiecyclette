// Schéma de la base de données — Resa Mamiecyclette
// Modèle : mise en relation de bénéficiaires (passagers) et de pédaleurs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un créneau de balade. Capacité : 2 bénéficiaires + 1 pédaleur.
model Creneau {
  id                    String          @id @default(cuid())
  date                  DateTime
  dureeMinutes          Int             @default(60)
  capaciteBeneficiaires Int             @default(2)
  lieuDepart            String          @default("Domicile de la personne")
  actif                 Boolean         @default(true)
  pedaleur              Pedaleur?       @relation(fields: [pedaleurId], references: [id])
  pedaleurId            String?
  confirmeLe            DateTime?
  disponibilites        Disponibilite[]
  createdAt             DateTime        @default(now())

  @@index([date])
}

// Type de bénéficiaire : une personne (passager) ou une structure (EHPAD,
// association…) qui réserve un créneau entier avec son propre pédaleur.
enum TypeBeneficiaire {
  PERSONNE
  STRUCTURE
}

// Un bénéficiaire (passager ou structure). Pas de compte : identifié par sa fiche.
model Beneficiaire {
  id                    String           @id @default(cuid())
  type                  TypeBeneficiaire @default(PERSONNE)
  nom                   String
  telephone             String
  email                 String?
  adresse               String?
  besoinsParticuliers   String?          @db.Text
  nbBeneficiairesEstime Int?             // structures : nombre estimé de personnes promenées
  couple                Boolean          @default(false) // personne : un couple, occupe les 2 places
  disponibilites      Disponibilite[]
  createdAt           DateTime        @default(now())
}

enum StatutDisponibilite {
  EN_ATTENTE // disponibilité proposée, en attente de mise en relation
  CONFIRMEE  // balade confirmée par un pédaleur
  LIBEREE    // libérée car le bénéficiaire a été confirmé sur un autre créneau
  ANNULEE    // annulée par l'équipe
}

// Une disponibilité : un bénéficiaire se déclare dispo sur un créneau.
model Disponibilite {
  id             String              @id @default(cuid())
  creneau        Creneau             @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  creneauId      String
  beneficiaire   Beneficiaire        @relation(fields: [beneficiaireId], references: [id], onDelete: Cascade)
  beneficiaireId String
  statut         StatutDisponibilite @default(EN_ATTENTE)
  createdAt      DateTime            @default(now())

  @@index([creneauId])
  @@index([beneficiaireId])
  @@index([statut])
}

// Un pédaleur : bénévole qui pédale. Dispose d'un compte (inscription libre).
// Téléphone, date de naissance et adresse : demandés pour l'assurance du CCAS
// (facultatifs en base pour les comptes créés avant que ces champs existent).
model Pedaleur {
  id             String    @id @default(cuid())
  email          String    @unique
  nom            String
  telephone      String?
  dateNaissance  DateTime? @db.Date
  adresse        String?
  motDePasseHash String
  derniereVisite DateTime? // pour signaler les balades apparues depuis sa dernière visite
  creneaux       Creneau[]
  createdAt      DateTime  @default(now())
}

// Réglages internes (singleton). genereJusquau = date jusqu'à laquelle les
// créneaux récurrents ont déjà été générés (repère glissant). versionDonnees =
// dernière mise à jour ponctuelle des données appliquée (voir lib/creneaux.ts).
model Configuration {
  id             Int       @id @default(1)
  genereJusquau  DateTime?
  versionDonnees Int       @default(0)
}
