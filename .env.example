# ------------------------------------------------------------------
# Configuration Resa Mamiecyclette
# Copiez ce fichier en `.env` et remplissez les valeurs.
# Sur Railway, renseignez ces variables dans l'onglet "Variables".
# ------------------------------------------------------------------

# Base de données PostgreSQL.
# En local : lancez un Postgres (ou Docker) et adaptez l'URL.
# Sur Railway : ajoutez un plugin PostgreSQL, la variable est fournie automatiquement.
DATABASE_URL="postgresql://user:password@localhost:5432/mamiecyclette?schema=public"

# Mot de passe de l'espace admin (partagé par l'équipe du CCAS / bénévoles).
ADMIN_PASSWORD="change-moi"

# Secret utilisé pour signer le cookie de session admin (chaîne aléatoire longue).
SESSION_SECRET="change-moi-par-une-longue-chaine-aleatoire"

# ------------------------------------------------------------------
# Envoi des emails (notifications). Optionnel : si non renseigné,
# les emails sont simplement affichés dans les logs (mode démo).
# Exemple avec un SMTP classique (OVH, Gmail, Brevo/Sendinblue, etc.)
# ------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Adresse d'expéditeur affichée dans les emails.
MAIL_FROM="Mamiecyclette <ne-pas-repondre@exemple.fr>"

# Adresse de l'équipe qui reçoit une alerte à chaque nouvelle réservation.
MAIL_EQUIPE="ccas@exemple.fr"
